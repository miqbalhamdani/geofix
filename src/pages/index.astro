---
import GuideSection from '../components/GuideSection.astro';
import IssuePanel from '../components/IssuePanel.astro';
import Layout from '../layouts/Layout.astro';
import MapViewer from '../components/MapViewer.astro';
import PolygonInput from '../components/PolygonInput.astro';
import PolygonOutput from '../components/PolygonOutput.astro';
---

<Layout title="PolyFix - Geometry Repair Tool" description="Validate and repair polygon geometry instantly for WKT and GeoJSON.">
	<main class="pt-12 pb-20">
		<nav class="max-w-7xl mx-auto px-6 pt-4 flex justify-end gap-4">
			<button id="tour-btn" class="text-body-sm font-semibold text-secondary hover:text-primary transition-colors flex items-center gap-1 group">
				<span class="material-symbols-outlined text-[18px]">tour</span>
				Take a Tour
			</button>
			<a class="text-body-sm font-semibold text-secondary hover:text-primary transition-colors flex items-center gap-1 group" href="https://www.iqbalhamdani.com/" target="_blank" rel="noopener noreferrer">
				About Me
				<span class="material-symbols-outlined text-[18px] group-hover:translate-x-0.5 transition-transform">arrow_outward</span>
			</a>
		</nav>

		<section class="max-w-7xl mx-auto px-6 text-center mb-16">
			<div class="inline-flex items-center gap-2 bg-surface-container border border-outline-variant rounded-full px-4 py-1.5 mb-6">
				<span class="material-symbols-outlined text-[16px] text-secondary">verified_user</span>
				<span class="font-label-caps text-label-caps uppercase tracking-widest text-secondary">EUDR Compliant</span>
			</div>
			<h1 class="font-h1 text-h1 mb-4 text-on-surface">Polygon Fixer</h1>
			<p class="font-body-lg text-body-lg text-secondary max-w-2xl mx-auto">
				Validate and repair polygon geometry instantly. Professional-grade geospatial correction optimized for European Union Deforestation Regulation compliance.
			</p>
		</section>

		<section class="max-w-7xl mx-auto px-6 mb-12">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter">
				<div id="input-section"><PolygonInput /></div>
				<div id="output-section"><PolygonOutput /></div>
			</div>
		</section>

		<section class="max-w-7xl mx-auto px-6 mb-12">
			<div id="validate-map-row" class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
				<IssuePanel />
				<MapViewer />
			</div>
		</section>

		<GuideSection />
	</main>

	<script>
		import { initPolygonFixApp } from '../features/fixer/app-controller';
		import { startTour } from '../shared/tour/tour';

		initPolygonFixApp();

		document.getElementById('tour-btn')?.addEventListener('click', () => startTour());
	</script>
</Layout>
